# ── Clerk (autenticación y usuarios) ────────────────────────────────────────
# El CLI de Clerk ya dejó claves de desarrollo en .env.local.
# estas son las que necesitas en .env.local para que la app funcione.
# Dashboard: https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Rutas de auth
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Para sincronizar usuarios con la base de datos (webhooks) — más adelante
CLERK_WEBHOOK_SECRET=whsec_...

# ── Modo demostración ──────────────────────────────────────────────────────
# Póntelo en 1 para entrar a /estudiante y /tutor sin iniciar sesión.
# Se ignora en producción: con NODE_ENV=production la app exige Clerk siempre.
DEMO_SIN_AUTH=1

# ── Supabase · Postgres ─────────────────────────────────────────────────────
# El id de usuario de Clerk es la llave de los usuarios en la base de datos.
# Esquema: apps/web/supabase/esquema.sql (pégalo en el SQL Editor de Supabase).
# Usa el "Session pooler" (Dashboard → Connect): funciona por IPv4. La conexión
# directa (db.<ref>.supabase.co) solo tiene IPv6 y falla en muchas redes.
DATABASE_URL=postgresql://postgres.<ref>:CONTRASENA@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:CONTRASENA@db.<ref>.supabase.co:5432/postgres

# ── AWS Bedrock (Claude, Converse API) ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ID del modelo. Verifica el tuyo en la consola de Bedrock para tu región.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
