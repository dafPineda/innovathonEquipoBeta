# ── Supabase ────────────────────────────────────────────────────────────
# Project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: backend-only, NUNCA en el cliente ni en git
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: para futuro frontend (browsers), respeta RLS
SUPABASE_ANON_KEY=

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Reglas de negocio (overrides opcionales, hay defaults en el código) ──
# Comisión de la plataforma sobre cada sesión liquidada (0-30)
PLATFORM_FEE_PERCENT=10
# Créditos de bienvenida para estudiantes nuevos
SIGNUP_BONUS_CREDITS=20
# Créditos concedidos a tutores verificados
TUTOR_ONBOARDING_BONUS_CREDITS=5
